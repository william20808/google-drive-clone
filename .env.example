# ==============================================================================
# Google Drive Clone - Environment Configuration (.env)
# Simply copy this file to .env and adjust your keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Django Settings
# ------------------------------------------------------------------------------
# Set DJANGO_DEBUG to False in production. In development, True provides debug tools.
DJANGO_DEBUG=True

# Provide a strong, unique secret key in production (e.g. 50+ random characters)
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-random-secret-key-in-production

# Comma-separated list of allowed hostnames (e.g. localhost,127.0.0.1,yourdomain.com)
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# 2. Zero-Knowledge Media Encryption (Confidentiality & Privacy)
# ------------------------------------------------------------------------------
# All uploaded files are encrypted at rest using AES-128 in CBC mode + HMAC-SHA256.
# If left blank, a strong key is automatically derived from DJANGO_SECRET_KEY.
# Or provide your own custom 32-byte URL-safe base64 key:
# (Generate one in Python: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# MEDIA_ENCRYPTION_KEY=your_base64_encryption_key_here

# ------------------------------------------------------------------------------
# 3. Database Configuration (SQLite vs. PostgreSQL)
# ------------------------------------------------------------------------------
# Default: Zero-setup SQLite (leave blank or commented out)
# DATABASE_URL=

# To use PostgreSQL (Render, Railway, Supabase, Neon, AWS RDS, Docker):
# Option A: Full Connection URL
# DATABASE_URL=postgres://postgres:password@localhost:5432/gdrive_db

# Option B: Individual PostgreSQL parameters
# POSTGRES_DB=gdrive_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. Cloud Object Storage (Optional: AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
# Set USE_S3=True when deploying on stateless cloud containers (Render, Heroku, Fly.io)
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1

# For Cloudflare R2 or MinIO (leave blank for standard AWS S3):
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
